# Copy this file to `.streamlit/secrets.toml` and fill in real values.
# Do NOT commit `.streamlit/secrets.toml` to git.
# For local development, use a .env file with the same key names instead.

# Course branding — shown as the app title and in the system prompt
COURSE_NAME = "My Course Name: Ask a question"

# OpenRouter API key — used to call DeepSeek-V3 (model "deepseek/deepseek-chat")
OPENROUTER_API_KEY = "sk-or-v1-your-openrouter-key-here"

# OpenAI API key — used for the text-embedding-3-small embedding model (embeddings only)
OPEN_AI_EMBEDDINGS_API_KEY = "sk-your-openai-key-here"

# Qdrant Cloud cluster endpoint (e.g., https://xyz-abc.eu-central.aws.cloud.qdrant.io:6333)
QDRANT_URL = "https://your-cluster-id.your-region.aws.cloud.qdrant.io:6333"

# Qdrant Cloud API key
QDRANT_API_KEY = "your-qdrant-api-key-here"
